      "name": "Offers",
      "item": [
        {
          "name": "01 Create offer (201, DRAFT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 30);",
                  "pm.collectionVariables.set('validUntil', d.toISOString().substring(0, 10));",
                  "pm.collectionVariables.set('customerId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON', () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test('Offer has id and offer number OFF-YYYY-NNNN', () => {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.offerNumber).to.match(/^OFF-\\d{4}-\\d{4}$/);",
                  "});",
                  "pm.test('New offer is in DRAFT status', () => pm.expect(body.status).to.eql('DRAFT'));",
                  "pm.test('Response time is below 1000 ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.collectionVariables.set('offerId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"title\": \"Postman offer\",\n  \"description\": \"Created from Postman collection\",\n  \"currency\": \"EUR\",\n  \"priceTotal\": 4200.00,\n  \"validUntil\": \"{{validUntil}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "offers"
              ]
            }
          }
        },
        {
          "name": "02 Get offer by id (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returned offer matches created one', () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('offerId'));",
                  "  pm.expect(body.title).to.eql('Postman offer');",
                  "  pm.expect(body.currency).to.eql('EUR');",
                  "});"
                ]
              }
            }
          ],
