              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Title and price were updated, status unchanged', () => {",
                  "  pm.expect(body.title).to.eql('Postman offer - updated');",
                  "  pm.expect(body.priceTotal).to.eql(4500);",
                  "  pm.expect(body.status).to.eql('DRAFT');",
